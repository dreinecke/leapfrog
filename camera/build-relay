#!/usr/bin/env bash
set -euo pipefail

CAMERA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UPSTREAM_URL="https://gitlab.com/vicamo/v4l2-relayd.git"
UPSTREAM_REV="d6ec36aae87e765eddef8308f0f58c7b5be95ad7"
DESTINATION="${1:-$HOME/.local/libexec/leapfrog-camera-relayd}"

for command_name in git autoreconf automake autoconf make pkg-config install; do
  command -v "$command_name" >/dev/null 2>&1 || {
    printf 'Missing build command: %s\n' "$command_name" >&2
    exit 1
  }
done

BUILD_DIR="$(mktemp -d /tmp/leapfrog-camera-build.XXXXXX)"
trap 'find "$BUILD_DIR" -depth -delete' EXIT

git -C "$BUILD_DIR" init -q
git -C "$BUILD_DIR" remote add origin "$UPSTREAM_URL"
git -C "$BUILD_DIR" fetch -q --depth=1 origin "$UPSTREAM_REV"
git -C "$BUILD_DIR" checkout -q --detach FETCH_HEAD
git -C "$BUILD_DIR" apply "$CAMERA_DIR/v4l2-relayd-timestamps.patch"

(
  cd "$BUILD_DIR"
  ./autogen.sh >/dev/null
  ./configure CFLAGS="${CFLAGS:--O2 -pipe}" >/dev/null
  make -j"$(nproc)" >/dev/null
)

install -Dm755 "$BUILD_DIR/src/v4l2-relayd" "$DESTINATION"
printf 'Installed %s\n' "$DESTINATION"
