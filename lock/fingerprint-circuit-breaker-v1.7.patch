+      if (fingerprintFastFailures >= 3) {
+        fingerprintPaused = true
+        logEvent("fingerprint-paused: repeated-service-errors")
+        return
+      }
+      fingerprintRetryTimer.interval = 1000 * Math.pow(2, fingerprintFastFailures - 1)
+    } else {
